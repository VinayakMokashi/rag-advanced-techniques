# API keys. Copy this file to ".env" and paste your keys below.
#
# rag05.py (PDF chat app) needs GROQ_API_KEY.
# rag14.py and rag15.py (agentic RAG) need CEREBRAS_API_KEY or GROQ_API_KEY;
# Cerebras is used when both are set.
#
# Free Groq key:  https://console.groq.com/keys
# Cerebras key:   https://cloud.cerebras.ai
GROQ_API_KEY=
CEREBRAS_API_KEY=
